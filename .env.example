# Copy to .env and fill in. Never commit .env.

# MetaTrader 5 account (use a demo account first)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# LLM providers (only needed for the Agno agent examples; Ollama needs no key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Folder with historical 1-minute CSV data (see README, "Data")
FX_DATA_DIR=data/FX-1-Minute-Data
